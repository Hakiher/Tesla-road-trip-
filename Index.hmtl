```html
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Passage - Tesla Passenger VS Suite</title>

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- FontAwesome Icons CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Google Fonts: Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;800;900&display=swap" rel="stylesheet">

    <!-- Leaflet CSS & JS with Fallback Detector -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" id="leaflet-css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" id="leaflet-js"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        teslaRed: '#E82127',
                        teslaBlue: '#3E6AE1',
                        teslaDark: '#0A0A0C',
                        teslaPanel: 'rgba(18, 18, 22, 0.96)',
                        teslaBorder: 'rgba(255, 255, 255, 0.12)',
                        teslaCyan: '#00F0FF',
                        teslaGreen: '#34C759',
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    <style>
        * {
            box-sizing: border-box;
            user-select: none;
            -webkit-user-select: none;
            touch-action: manipulation;
        }

        body {
            background-color: #0A0A0C;
            color: #F2F2F7;
            overflow: hidden;
            font-family: 'Inter', sans-serif;
            width: 100vw;
            height: 100vh;
            margin: 0;
            padding: 0;
        }

        #map-container {
            position: absolute;
            inset: 0;
            width: 100vw;
            height: 100vh;
            z-index: 0;
            background: #0A0A0C;
        }

        #leaflet-map, #canvas-map {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
        }

        .leaflet-container {
            background: #09090b !important;
        }

        .glass-panel {
            background: rgba(18, 18, 22, 0.96);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.12);
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.8);
        }

        /* Custom Scrollbars */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(0,0,0,0.3);
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.25);
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #E82127;
        }

        /* Custom Pulse Marker for Leaflet */
        .stop-marker-pulse {
            width: 22px;
            height: 22px;
            background: rgba(0, 240, 255, 0.85);
            border: 3px solid #ffffff;
            border-radius: 50%;
            box-shadow: 0 0 15px #00F0FF;
            animation: radarPulse 2s infinite;
        }
        @keyframes radarPulse {
            0% { box-shadow: 0 0 0 0 rgba(0, 240, 255, 0.7); }
            70% { box-shadow: 0 0 0 14px rgba(0, 240, 255, 0); }
            100% { box-shadow: 0 0 0 0 rgba(0, 240, 255, 0); }
        }

        .car-marker-icon {
            filter: drop-shadow(0px 0px 12px #E82127);
            transition: transform 0.3s ease-out;
        }
    </style>
</head>
<body class="relative h-screen w-screen overflow-hidden">

    <!-- MAP CONTAINER WITH LEAFLET + CANVAS PROCEDURAL FALLBACK -->
    <div id="map-container">
        <div id="leaflet-map"></div>
        <canvas id="canvas-map" class="hidden"></canvas>
    </div>

    <!-- TOP TELEMETRY & APP BAR -->
    <header class="absolute top-0 left-0 right-0 z-20 px-6 py-2.5 flex items-center justify-between glass-panel border-b border-teslaBorder">
        <!-- Brand & Connection Status -->
        <div class="flex items-center space-x-3">
            <i class="fa-solid fa-car-side text-teslaRed text-2xl"></i>
            <div>
                <div class="flex items-center space-x-2">
                    <span class="font-black text-lg tracking-wider text-white">PASSAGE</span>
                    <span class="text-[9px] font-mono bg-teslaRed/20 text-teslaRed px-1.5 py-0.5 rounded border border-teslaRed/40 font-bold">VS SUITE</span>
                </div>
                <span class="text-[10px] text-gray-400 font-mono block">Tesla Model 3 Dashboard Edition</span>
            </div>
        </div>

        <!-- Telemetry Metrics Bar -->
        <div class="hidden md:flex items-center space-x-3 text-xs font-mono">
            <div class="flex items-center space-x-2 bg-black/60 px-3 py-1.5 rounded-xl border border-teslaBorder">
                <i class="fa-solid fa-location-dot text-teslaCyan"></i>
                <span id="tel-location" class="text-white font-bold">I-65 N, Crawfordsville, IN</span>
            </div>
            <div class="flex items-center space-x-2 bg-black/60 px-3 py-1.5 rounded-xl border border-teslaBorder">
                <i class="fa-solid fa-gauge-high text-teslaGreen"></i>
                <span id="tel-speed" class="text-white font-bold">68 MPH</span>
            </div>
            <div class="flex items-center space-x-2 bg-black/60 px-3 py-1.5 rounded-xl border border-teslaBorder">
                <i class="fa-solid fa-battery-three-quarters text-teslaGreen"></i>
                <span id="tel-battery" class="text-white font-bold">78%</span>
            </div>
            <div class="flex items-center space-x-2 bg-black/60 px-3 py-1.5 rounded-xl border border-teslaBorder">
                <i class="fa-solid fa-mountain text-yellow-400"></i>
                <span id="tel-alt" class="text-white font-bold">790 FT</span>
            </div>
            <div class="flex items-center space-x-2 bg-black/60 px-3 py-1.5 rounded-xl border border-teslaBorder">
                <i class="fa-solid fa-route text-teslaBlue"></i>
                <span id="tel-dest" class="text-white font-bold">NAV: Chicago, IL</span>
            </div>
        </div>

        <!-- Controls: Map Mode Indicator & Sound Toggle -->
        <div class="flex items-center space-x-2">
            <span id="map-mode-badge" class="hidden sm:inline-block text-[10px] font-mono px-2 py-1 rounded-lg bg-black/60 border border-teslaBorder text-teslaCyan font-bold">
                MAP: LEAFLET
            </span>
            <button onclick="toggleAudio()" id="audio-toggle-btn" class="p-2.5 rounded-xl bg-black/60 border border-teslaBorder text-teslaCyan hover:border-teslaCyan transition flex items-center justify-center">
                <i id="audio-icon" class="fa-solid fa-volume-high text-sm"></i>
            </button>
            <div class="flex items-center space-x-1.5 px-2.5 py-1.5 rounded-xl bg-teslaRed/20 border border-teslaRed/40 text-xs font-mono font-bold text-teslaRed">
                <i class="fa-solid fa-circle text-[8px] animate-pulse"></i>
                <span>DRIVE</span>
            </div>
        </div>
    </header>

    <!-- PLAYER MULTIPLAYER SCOREBAR (SUB-HEADER) -->
    <div id="player-scorebar" class="absolute top-16 left-0 right-0 z-10 px-6 py-2 bg-black/75 backdrop-blur-md border-b border-teslaBorder flex items-center justify-around font-mono text-xs overflow-x-auto">
        <!-- Rendered dynamically via JS -->
    </div>

    <!-- RE-OPEN PANEL FLOATING PILL BUTTON (VISIBLE WHEN MINIMIZED) -->
    <button id="reopen-hud-btn" onclick="toggleHudWindow(true)" class="hidden absolute top-28 left-6 z-20 px-4 py-2.5 rounded-2xl glass-panel border border-teslaCyan text-teslaCyan text-xs font-bold font-mono shadow-2xl hover:bg-teslaCyan hover:text-black transition flex items-center space-x-2">
        <i class="fa-solid fa-window-restore text-sm"></i>
        <span>OPEN PASSAGE DOCK</span>
    </button>

    <!-- MAIN FLOATING HUD DOCK PANEL (LEFT SIDE) -->
    <main id="hud-dock-panel" class="absolute top-28 left-6 z-10 w-[460px] max-w-[calc(100vw-3rem)] h-[calc(100vh-13rem)] glass-panel p-5 rounded-3xl flex flex-col justify-between transition-all duration-300">
        <!-- Panel Header with Minimize/Close Button -->
        <div class="flex items-center justify-between pb-3 border-b border-teslaBorder mb-3">
            <span class="text-xs font-bold text-gray-400 font-mono uppercase tracking-wider flex items-center space-x-2">
                <i class="fa-solid fa-layer-group text-teslaCyan"></i>
                <span>PASSENGER ACTIVITIES DOCK</span>
            </span>
            <button onclick="toggleHudWindow(false)" title="Minimize / Close Window" class="w-7 h-7 rounded-full bg-black/60 border border-teslaBorder text-gray-400 hover:text-white hover:border-teslaRed hover:bg-teslaRed/20 transition flex items-center justify-center">
                <i class="fa-solid fa-xmark text-sm"></i>
            </button>
        </div>

        <!-- Dynamic Tab Content Container -->
        <div id="tab-content-container" class="flex-1 overflow-y-auto pr-1 space-y-4">
            <!-- Injected by JavaScript -->
        </div>

        <!-- Dynamic Card Footer Container -->
        <div id="tab-footer-container" class="pt-3 border-t border-teslaBorder shrink-0 mt-3 flex justify-between items-center text-xs">
            <!-- Injected by JavaScript -->
        </div>
    </main>

    <!-- DRIVE CONTROLLER WIDGET (BOTTOM RIGHT OVERLAY) -->
    <div class="absolute bottom-16 right-6 z-10 glass-panel p-3.5 rounded-2xl border border-teslaBorder max-w-xs space-y-2 text-xs font-mono">
        <div class="flex items-center justify-between">
            <span class="text-gray-400 font-bold flex items-center space-x-1.5">
                <i class="fa-solid fa-sliders text-teslaCyan"></i>
                <span>DRIVE SIMULATOR</span>
            </span>
            <button onclick="toggleDriveSim()" id="sim-play-btn" class="px-2 py-0.5 rounded bg-teslaGreen/20 text-teslaGreen border border-teslaGreen/40 font-bold hover:bg-teslaGreen hover:text-white transition">
                PAUSE
            </button>
        </div>
        
        <div class="flex items-center space-x-2">
            <span class="text-[10px] text-gray-400">ROUTE:</span>
            <select id="route-selector" onchange="changeRoute(this.value)" class="bg-black/60 border border-teslaBorder rounded-lg px-2 py-1 text-white text-xs focus:outline-none w-full">
                <option value="indiana">Midwest I-65 (IN -> IL)</option>
                <option value="westcoast">West Coast I-5 (LA -> SF)</option>
                <option value="eastcoast">East Coast I-95 (NY -> DC)</option>
            </select>
        </div>

        <div class="flex items-center space-x-2">
            <span class="text-[10px] text-gray-400">SPEED:</span>
            <input type="range" id="speed-slider" min="30" max="90" value="68" oninput="updateDriveSpeed(this.value)" class="w-full accent-teslaRed">
            <span id="speed-val" class="text-teslaGreen font-bold min-w-[45px]">68 MPH</span>
        </div>
    </div>

    <!-- FIXED BOTTOM CONTROL NAVIGATION DOCK -->
    <nav class="absolute bottom-3 left-1/2 -translate-x-1/2 z-20 glass-panel px-4 py-2 rounded-2xl flex items-center space-x-1.5 border border-teslaBorder shadow-2xl max-w-full overflow-x-auto">
        <button onclick="switchTab('lobby')" id="nav-btn-lobby" class="px-3.5 py-2 rounded-xl text-xs font-bold transition flex items-center space-x-2 text-gray-400 hover:text-white hover:bg-black/40 whitespace-nowrap">
            <i class="fa-solid fa-users text-sm"></i>
            <span>LOBBY</span>
        </button>
        <button onclick="switchTab('trivia')" id="nav-btn-trivia" class="px-3.5 py-2 rounded-xl text-xs font-bold transition flex items-center space-x-2 bg-teslaRed text-white whitespace-nowrap">
            <i class="fa-solid fa-bolt text-sm"></i>
            <span>VS TRIVIA</span>
        </button>
        <button onclick="switchTab('bingo')" id="nav-btn-bingo" class="px-3.5 py-2 rounded-xl text-xs font-bold transition flex items-center space-x-2 text-gray-400 hover:text-white hover:bg-black/40 whitespace-nowrap">
            <i class="fa-solid fa-flag-checkered text-sm"></i>
            <span>VS BINGO</span>
        </button>
        <button onclick="switchTab('scavenger')" id="nav-btn-scavenger" class="px-3.5 py-2 rounded-xl text-xs font-bold transition flex items-center space-x-2 text-gray-400 hover:text-white hover:bg-black/40 whitespace-nowrap">
            <i class="fa-solid fa-camera text-sm"></i>
            <span>VS HUNT</span>
        </button>
        <button onclick="switchTab('twenty')" id="nav-btn-twenty" class="px-3.5 py-2 rounded-xl text-xs font-bold transition flex items-center space-x-2 text-gray-400 hover:text-white hover:bg-black/40 whitespace-nowrap">
            <i class="fa-solid fa-question text-sm"></i>
            <span>VS 20 Qs</span>
        </button>
        <button onclick="switchTab('stops')" id="nav-btn-stops" class="px-3.5 py-2 rounded-xl text-xs font-bold transition flex items-center space-x-2 text-gray-400 hover:text-white hover:bg-black/40 whitespace-nowrap">
            <i class="fa-solid fa-map-pin text-sm"></i>
            <span>STOPS RADAR</span>
        </button>
        <button onclick="switchTab('safety')" id="nav-btn-safety" class="px-3.5 py-2 rounded-xl text-xs font-bold transition flex items-center space-x-2 text-teslaCyan hover:text-white hover:bg-black/40 whitespace-nowrap">
            <i class="fa-solid fa-shield-halved text-sm"></i>
            <span>SAFETY & API</span>
        </button>
    </nav>

    <!-- TESLA NAV TOAST NOTIFICATION -->
    <div id="nav-toast" class="hidden absolute top-28 right-6 z-30 glass-panel border-2 border-teslaCyan p-4 rounded-2xl shadow-2xl flex items-center space-x-4 max-w-sm">
        <div class="w-10 h-10 rounded-xl bg-teslaCyan/20 text-teslaCyan flex items-center justify-center text-xl shrink-0">
            <i class="fa-solid fa-location-arrow"></i>
        </div>
        <div>
            <span class="text-xs text-teslaCyan font-bold block uppercase tracking-wider">Sent to Tesla Navigation</span>
            <span id="nav-toast-msg" class="text-xs font-semibold text-white">Routing to landmark...</span>
        </div>
    </div>

    <!-- JAVASCRIPT APPLICATION CORE -->
    <script>
        /* ==========================================================================
           1. SOUND ENGINE (WEB AUDIO API SYNTHESIZER - NO EXTERNAL MP3s)
           ========================================================================== */
        let audioCtx = null;
        let soundEnabled = true;

        function initAudioContext() {
            if (!audioCtx) {
                const AudioContext = window.AudioContext || window.webkitAudioContext;
                if (AudioContext) audioCtx = new AudioContext();
            }
            if (audioCtx && audioCtx.state === 'suspended') {
                audioCtx.resume();
            }
        }

        function playBeep(freq = 440, type = 'sine', duration = 0.15) {
            if (!soundEnabled) return;
            try {
                initAudioContext();
                if (!audioCtx) return;

                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();

                osc.type = type;
                osc.frequency.setValueAtTime(freq, audioCtx.currentTime);

                gain.gain.setValueAtTime(0.15, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + duration);

                osc.connect(gain);
                gain.connect(audioCtx.destination);

                osc.start();
                osc.stop(audioCtx.currentTime + duration);
            } catch (e) {
                console.warn("Audio synth warning:", e);
            }
        }

        function playSuccessSound() {
            if (!soundEnabled) return;
            playBeep(523.25, 'triangle', 0.1); // C5
            setTimeout(() => playBeep(659.25, 'triangle', 0.1), 100); // E5
            setTimeout(() => playBeep(783.99, 'triangle', 0.2), 200); // G5
        }

        function playErrorSound() {
            if (!soundEnabled) return;
            playBeep(220, 'sawtooth', 0.15); // A3
            setTimeout(() => playBeep(185, 'sawtooth', 0.25), 150);
        }

        function toggleAudio() {
            soundEnabled = !soundEnabled;
            const icon = document.getElementById('audio-icon');
            const btn = document.getElementById('audio-toggle-btn');

            if (soundEnabled) {
                btn.className = "p-2.5 rounded-xl bg-black/60 border border-teslaBorder text-teslaCyan hover:border-teslaCyan transition flex items-center justify-center";
                icon.className = "fa-solid fa-volume-high text-sm";
                playBeep(600, 'sine', 0.1);
            } else {
                btn.className = "p-2.5 rounded-xl bg-black/60 border border-teslaBorder text-gray-500 transition flex items-center justify-center";
                icon.className = "fa-solid fa-volume-xmark text-sm";
                if ('speechSynthesis' in window) window.speechSynthesis.cancel();
            }
        }

        function speakText(text) {
            if (!soundEnabled || !('speechSynthesis' in window)) return;
            try {
                window.speechSynthesis.cancel();
                const utterance = new SpeechSynthesisUtterance(text);
                utterance.rate = 1.0;
                window.speechSynthesis.speak(utterance);
            } catch(e) {
                console.warn("Speech Synthesis error:", e);
            }
        }

        /* ==========================================================================
           2. STATE & DATA STRUCTURES
           ========================================================================== */
        let state = {
            activeTab: 'lobby',
            hudMinimized: false,
            simulating: true,
            speed: 68,
            battery: 78,
            altitude: 790,
            activeRouteKey: 'indiana',
            routeIndex: 0,
            mapMode: 'leaflet', // 'leaflet' or 'canvas'
            currentTriviaIndex: 0,
            activeTriviaPlayerTurn: 0,
            triviaTimer: 15,
            triviaTimerInterval: null,
            players: [
                { id: 0, name: 'Driver / Alex', seat: 'Driver / Front Left', color: '#3B82F6', score: 0, streak: 0, avatar: 'fa-user-astronaut' },
                { id: 1, name: 'Co-Pilot / Sam', seat: 'Front Right', color: '#EC4899', score: 0, streak: 0, avatar: 'fa-user-ninja' }
            ],
            bingoClaimed: {},
            scavengerTarget: "Wind Turbine or Solar Farm",
            scavengerClaimedBy: null,
            twentyQs: {
                secretWord: "Supercharger Station",
                category: "Roadside Landmark",
                guesserIdx: 1,
                masterIdx: 0,
                guessesLeft: 10,
                history: [
                    { q: "Is it an electronic structure?", a: "Yes" },
                    { q: "Is it found near highways?", a: "Yes" }
                ]
            }
        };

        const routes = {
            indiana: {
                name: "Midwest I-65 (IN -> IL)",
                locationLabel: "I-65 N, Crawfordsville, IN",
                destination: "NAV: Chicago, IL",
                path: [
             
